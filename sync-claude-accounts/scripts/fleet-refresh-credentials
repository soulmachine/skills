#!/bin/bash
# fleet-refresh-credentials — single-writer credential redistribution.
#
# THE PROBLEM THIS SOLVES: a Claude OAuth refresh token is single-use and rotates
# server-side on every use. When N machines share an account, whichever refreshes first
# invalidates every other copy, and the losers get `invalid_grant` → "refresh token dead".
# One strike is permanent, so it shows up as accounts dying at random days later.
#
# THE FIX: exactly ONE machine (this one) is allowed to refresh. Every other machine only
# ever *consumes* an access token, which never triggers rotation. This script exports this
# machine's live credentials and pushes them to the receivers often enough that their access
# tokens never come close to expiry, so nothing over there ever needs to refresh.
#
# Both credential stores must be refreshed. cswap and cux keep SEPARATE backups (keychain
# services `claude-swap` and `cux-backup`); refreshing only cswap's would leave cux swapping
# in an already-rotated refresh token. The per-machine sync script handles both.
#
# Usage: fleet-refresh-credentials [--dry-run]
set -uo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# cux ships via npm under mise-managed node, which is NOT on the LaunchAgent's PATH.
# Verified 2026-08-19: `command -v cux` finds nothing under the PATH above. Without this
# the cux resync in proactive_refresh() silently no-ops, leaving cux holding the SPENT
# refresh token while cswap holds the fresh one — the split-brain the header warns about,
# and it would surface days later as a random death.
_NODEBIN="$(ls -d "$HOME"/.local/share/mise/installs/node/latest/bin 2>/dev/null | head -1)"
[ -n "$_NODEBIN" ] || _NODEBIN="$(ls -d "$HOME"/.local/share/mise/installs/node/*/bin 2>/dev/null | head -1)"
[ -n "$_NODEBIN" ] && export PATH="$PATH:$_NODEBIN"

# Receivers. Override with FLEET_HOSTS="a b c" to run this against a different fleet.
read -r -a HOSTS <<<"${FLEET_HOSTS:-mac-mini-2018 mac-mini-m2 archs-mac-mini mac-studio-m3}"

# Resolve siblings relative to THIS script so the checked-in copy works wherever the repo is
# cloned, rather than depending on one machine's home-directory layout. Falls back to $HOME
# for a copy installed outside the repo.
# Follow symlinks before taking dirname. This script is normally installed as a
# ~/.local/bin symlink pointing into the repo, and the sibling lookups below must resolve
# against the REPO copy — otherwise SELF_DIR is ~/.local/bin and everything silently depends
# on the hardcoded fallback instead. (BSD readlink historically has no -f, hence the loop.)
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
    _link="$(readlink "$_self")"
    case "$_link" in
        /*) _self="$_link" ;;
        *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SELF_DIR="$(cd "$(dirname "$_self")" && pwd -P)"
# push-claude-accounts is a SIBLING of this script — both ship in the same skill. This used to
# hunt for a separate skill directory by name, with a hardcoded fallback to one machine's home;
# merging claude-fleet-health into sync-claude-accounts on 2026-08-19 removed the need for both.
# A sibling lookup cannot go stale when a directory is renamed.
PUSH="$SELF_DIR/push-claude-accounts"

# The refresh helper ships next to this script; prefer that copy over whatever is on PATH.
REFRESH_HELPER="$SELF_DIR/claude-refresh-export"
[ -x "$REFRESH_HELPER" ] || REFRESH_HELPER="$(command -v claude-refresh-export || true)"

# claude-swap installs via `uv tool`, so its venv python is the only interpreter that can
# import claude_swap. Discover it rather than hardcoding one machine's path.
refresh_helper_python() {
    local c
    for c in "$HOME/.local/share/uv/tools/claude-swap/bin/python" \
             "$HOME/.local/share/uv/tools/claude-swap/bin/python3"; do
        [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    done
    command -v python3
}
EXPORT_FILE="/tmp/claude-accounts.json"
LOG="$HOME/Library/Logs/fleet-refresh.log"
# Below this much remaining access-token life, push even into a live cux session: a
# momentary account swap is cheaper than letting the receiver refresh and kill the fleet.
#
# RESIDUAL RISK, stated plainly. Receivers inherit whatever life the authority's token has
# left at push time, and that life sawtooths 8h -> 0 -> 8h. No cadence closes the trough
# completely: if a tick lands just before the authority refreshes, receivers briefly hold a
# nearly-expired token, and a receiver that runs Claude Code in that gap WILL refresh and
# rotate the token out from under everyone. Ticking every 30 min bounds that gap to ~30 min
# per ~8h cycle instead of the previous permanent 5-way race. Forcing only in the last 90
# minutes keeps disruptive mid-session swaps to a couple of ticks per cycle rather than
# every tick. Phase 3 monitoring exists precisely to catch the gap if it ever fires.
FORCE_BELOW_SECONDS="${FORCE_BELOW_SECONDS:-$((90 * 60))}"
DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

mkdir -p "$(dirname "$LOG")"
log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" | tee -a "$LOG"; }

# Credentials must never linger on disk; armed before the export exists.
cleanup() { rm -f "$EXPORT_FILE"; }
trap cleanup EXIT

command -v cswap >/dev/null 2>&1 || { log "FATAL cswap not found"; exit 1; }
[ -x "$PUSH" ] || { log "FATAL push script missing: $PUSH"; exit 1; }

# ---------- refuse to publish a broken export ----------
# --force overwrites each receiver, so pushing a dead account would destroy working copies
# elsewhere. This is not hypothetical: on 2026-08-17 this machine held a dead copy of one
# account while a single receiver held the only live one. Verify health BEFORE exporting.
DEAD="$(cswap list 2>/dev/null | sed $'s/\033\[[0-9;:]*m//g' | grep -c 're-login needed')"
if [ "$DEAD" -gt 0 ]; then
    log "ABORT $DEAD account(s) dead on the authority — refusing to push and overwrite"
    log "      healthy copies elsewhere. Repair here first (see refresh-claude-account),"
    log "      or re-seed from whichever machine still has a live copy."
    exit 1
fi

# ---------- never distribute a token that is about to die ----------
# Receivers inherit the authority's REMAINING life, so pushing a nearly-expired token does not
# top anyone up — it synchronises the whole fleet onto one fuse. That is not theoretical: on
# 2026-08-17 the 07:38 cycle pushed a token with 1 minute left to all four receivers, every
# machine hit expiry together at 07:40, whichever refreshed first rotated the token, and the
# authority's own copy died — a 4-hour outage during which every cycle correctly ABORTed.
# Receivers already hold this same token, so skipping costs them nothing; waiting for the
# authority to refresh and distributing the fresh 8h token is strictly better.
MIN_PUSH_LIFE=$((35 * 60))
own_life() {
    cswap list --token-status 2>/dev/null | /usr/bin/python3 -c '
import re,sys
best=None
txt=re.sub(r"\x1b\[[0-9;:]*m","",sys.stdin.read())
for m in re.finditer(r"expires\s+\d{1,2}:\d{2}\s+in\s+((?:\d+[dhm]\s*)+)", txt):
    secs=sum(int(n)*{"d":86400,"h":3600,"m":60}[u] for n,u in re.findall(r"(\d+)([dhm])", m.group(1)))
    if best is None or secs < best: best=secs
if best is not None: print(best)' 2>/dev/null
}

# ---------- proactive refresh: keep the authority ahead of its receivers ----------
# The single-writer rule says only this machine may refresh — but until 2026-08-19 nothing
# actually DROVE that refresh. claude-swap refreshes only lazily: when a token is already
# inside its 5-minute expiry buffer, and only for a slot that is NOT the active one (see
# oauth.try_fetch_usage_for_account). So the authority coasted to the edge of expiry, and the
# receivers — holding that same token, with refresh buffers of their own — could get there
# first. Whoever refreshed rotated the single-use token and struck everyone else dead.
#
# Refreshing EARLY and pushing in the SAME cycle removes the trough rather than shortening it:
# receivers are handed a fresh ~8h token long before anything of theirs comes due, so no
# receiver ever has a reason to refresh. A shorter cadence only makes the old race less likely;
# this makes it structurally unreachable.
REFRESH_BELOW="${REFRESH_BELOW:-$((90 * 60))}"

# INVARIANT: REFRESH_BELOW <= FORCE_BELOW_SECONDS. These two thresholds are coupled, and
# breaking the coupling strands a spent credential on the receivers.
#
# The moment this machine refreshes, the PREVIOUS generation's refresh token is spent. The
# receivers are still holding that generation, so they MUST be overwritten in this same cycle
# — if one instead defers (live cux session) and later reaches its own expiry, it will try to
# refresh with the spent token and strike itself permanently dead. Keeping REFRESH_BELOW at or
# under FORCE_BELOW_SECONDS guarantees that whenever we refresh, every receiver is already
# inside the force window and so is pushed through any live session rather than deferred.
if [ "$REFRESH_BELOW" -gt "$FORCE_BELOW_SECONDS" ]; then
    log "WARN REFRESH_BELOW ($((REFRESH_BELOW/60))m) > FORCE_BELOW_SECONDS ($((FORCE_BELOW_SECONDS/60))m):"
    log "     a refresh here could leave a deferring receiver holding the spent generation."
    log "     Raising FORCE_BELOW_SECONDS to match for this run."
    FORCE_BELOW_SECONDS="$REFRESH_BELOW"
fi

# Refresh in place, then make ALL THREE stores agree: cswap's per-slot backup, the live
# keychain login, and cux's separate backup. Anything left on the old generation is holding a
# SPENT refresh token and will fail permanently the next time it is used.
proactive_refresh() {
    local J="" orig="" other="" rf="" out="" rrc=0
    if [ -z "$REFRESH_HELPER" ] || [ ! -f "$REFRESH_HELPER" ]; then
        log "  refresh: claude-refresh-export not found — cannot refresh; falling through to HOLD"
        return 1
    fi
    J="$(cswap list --json 2>/dev/null)"
    orig="$(printf '%s' "$J" | /usr/bin/python3 -c 'import json,sys;print(json.load(sys.stdin).get("activeAccountNumber") or "")' 2>/dev/null)"
    other="$(printf '%s' "$J" | /usr/bin/python3 -c 'import json,sys
d=json.load(sys.stdin); act=d.get("activeAccountNumber")
print(next((str(a["number"]) for a in d.get("accounts",[]) if a.get("number")!=act), ""))' 2>/dev/null)"
    [ -n "$orig" ] || { log "  refresh: cannot read active slot — skipping"; return 1; }

    rf="$EXPORT_FILE"
    # Sync live -> the active slot's store BEFORE exporting. The export reads STORES, and
    # refreshing a store copy older than the live login would POST an already-spent refresh
    # token and strike the account permanently dead.
    if [ -n "$other" ]; then
        cswap switch "$other" --force </dev/null >/dev/null 2>&1 \
            || log "  refresh: switch-away failed (continuing)"
    fi
    if ! cswap export "$rf" >/dev/null 2>&1; then
        log "  refresh: export failed"
        cswap switch "$orig" --force </dev/null >/dev/null 2>&1
        return 1
    fi
    chmod 600 "$rf"

    out="$("$(refresh_helper_python)" "$REFRESH_HELPER" "$rf" "$REFRESH_BELOW" 2>&1)"; rrc=$?
    printf '%s\n' "$out" | while IFS= read -r ln; do [ -n "$ln" ] && log "      $ln"; done

    # Persist. `import` writes each slot's STORE but cannot touch the live login of the ACTIVE
    # slot, and the switch that follows backs the stale live credential over the OTHER slot's
    # store — hence the second import. Documented in the sync-claude-accounts skill.
    cswap import "$rf" --force </dev/null >/dev/null 2>&1 || log "  refresh: local import failed"
    cswap switch "$orig" --force </dev/null >/dev/null 2>&1
    cswap import "$rf" --force </dev/null >/dev/null 2>&1

    # cux keeps its own backup and only ever captures the CURRENTLY LIVE login, so each slot
    # must be made live in turn. Skipping this leaves cux to swap in the spent generation.
    if command -v cux >/dev/null 2>&1 && [ -f "$HOME/.cux/state.json" ]; then
        printf '%s' "$J" \
        | /usr/bin/python3 -c 'import json,sys;[print(a["number"],a["email"]) for a in json.load(sys.stdin).get("accounts",[])]' 2>/dev/null \
        | while read -r n e; do
            cswap switch "$n" --force </dev/null >/dev/null 2>&1 || continue
            # Map by EMAIL: cux slot numbers are independent of cswap's and are often inverted.
            m="$(/usr/bin/python3 -c 'import json,sys;s=json.load(open(sys.argv[1]));print(next((str(a["slot"])+" "+str(a.get("alias") or "") for a in s.get("accounts",{}).values() if a.get("email")==sys.argv[2]),""))' "$HOME/.cux/state.json" "$e" 2>/dev/null)"
            [ -n "$m" ] || continue
            cux add --slot "${m%% *}" --alias "${m#* }" >/dev/null 2>&1 \
                && log "      cux resynced: $e (cux slot ${m%% *})"
          done
    fi

    cswap switch "$orig" --force </dev/null >/dev/null 2>&1
    return "$rrc"
}

umask 077

LIFE="$(own_life)"
if [ -n "$LIFE" ] && [ "$LIFE" -lt "$REFRESH_BELOW" ] && [ "$DRY_RUN" != "1" ]; then
    log "REFRESH lowest credential has $((LIFE/60))m left (< $((REFRESH_BELOW/60))m) — refreshing here first"
    proactive_refresh || log "REFRESH incomplete — falling through to the HOLD check below"
    LIFE="$(own_life)"
    [ -n "$LIFE" ] && log "REFRESH complete — lowest credential now $((LIFE/60))m"
fi

# Backstop. With the proactive refresh working this is unreachable; it still matters when the
# refresh failed (a dead lineage, or the network down), where the old reasoning stands: pushing
# a nearly-dead token does not top anyone up, it synchronises the fleet onto one fuse.
if [ -n "$LIFE" ] && [ "$LIFE" -lt "$MIN_PUSH_LIFE" ]; then
    log "HOLD authority token has only $((LIFE/60))m left — not distributing a doomed token."
    log "     The proactive refresh did not take; receivers already hold this token, so waiting."
    exit 0
fi
cswap export "$EXPORT_FILE" >/dev/null 2>&1 || { log "FATAL cswap export failed"; exit 1; }
chmod 600 "$EXPORT_FILE"
NACC="$(/usr/bin/python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))["accounts"]))' "$EXPORT_FILE" 2>/dev/null || echo 0)"
[ "$NACC" -gt 0 ] || { log "FATAL export contains no accounts"; exit 1; }
# NB: ${DRY_RUN:+...} would expand for the string "0" too (non-empty), labelling every live
# run as a dry run. Test the value, not emptiness.
[ "$DRY_RUN" = "1" ] && mode=" (dry-run)" || mode=""
log "START exported $NACC account(s)$mode"

# Remaining access-token life on a receiver, in seconds; empty when unknown.
#
# MINIMUM ACROSS ALL SLOTS, not just the live login. Reading only the live credential
# measures the wrong thing on any machine whose two accounts have different expiries: the
# live one can look healthy for hours while the *other* slot's stored backup quietly expires,
# and cux swapping onto that slot then activates a dead token, refreshes it, and rotates it
# out from under the whole fleet — the exact race this script exists to prevent. Observed
# 2026-08-17: mac-mini-m2 reported "4h" from its live slot while the other slot's stored
# backup was 60 minutes from expiry, so it deferred every cycle and would have aged out.
#
# `cswap list --token-status` prints one "expires HH:MM in Xh Ym" per slot, covering both the
# active profile and stored backups.
remaining_life() {
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$1" '
        export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
        [ -f "$HOME/.claude/unlock-keychain.sh" ] && bash "$HOME/.claude/unlock-keychain.sh" >/dev/null 2>&1
        cswap list --token-status 2>/dev/null' 2>/dev/null \
    | /usr/bin/python3 -c '
import re,sys
best=None
# Strip ANSI, then take every "expires <clock> in [Nd] [Nh] [Nm]" duration.
txt=re.sub(r"\x1b\[[0-9;:]*m","",sys.stdin.read())
for m in re.finditer(r"expires\s+\d{1,2}:\d{2}\s+in\s+((?:\d+[dhm]\s*)+)", txt):
    secs=0
    for n,unit in re.findall(r"(\d+)([dhm])", m.group(1)):
        secs += int(n)*{"d":86400,"h":3600,"m":60}[unit]
    if best is None or secs < best: best=secs
if best is not None: print(best)' 2>/dev/null
}

ok=0; deferred=0; failed=0
for h in "${HOSTS[@]}"; do
    life="$(remaining_life "$h")"
    if [ -n "$life" ] && [ "$life" -lt "$FORCE_BELOW_SECONDS" ]; then
        skip_busy=0; why="token expires in $((life/60))m — forcing through any live session"
    else
        skip_busy=1; why="${life:+token good for $((life/3600))h — }deferring if cux is busy"
    fi
    log "  $h: $why"
    if [ "$DRY_RUN" = "1" ]; then continue; fi

    out="$(IMPORT_FORCE=1 SKIP_IF_CUX_BUSY="$skip_busy" "$PUSH" "$EXPORT_FILE" "$h" 2>&1)"
    rc=$?
    printf '%s\n' "$out" | sed 's/^/      /' >>"$LOG"
    # push-claude-accounts collapses the per-machine exit code, so read the deferral marker
    # out of the transcript rather than the status.
    if printf '%s' "$out" | grep -q 'cux session active — skipping'; then
        log "  $h: DEFERRED (cux session active)"; deferred=$((deferred+1))
    elif [ $rc -eq 0 ]; then
        log "  $h: OK"; ok=$((ok+1))
    else
        log "  $h: FAILED (rc=$rc)"; failed=$((failed+1))
    fi
done

log "DONE ok=$ok deferred=$deferred failed=$failed"
[ "$failed" -eq 0 ]
