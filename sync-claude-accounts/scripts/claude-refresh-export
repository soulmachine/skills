#!/usr/bin/env python3
# NOTE ON THE INTERPRETER: this imports `claude_swap`, which lives in claude-swap's own uv
# tool venv, not on the system python's path. fleet-refresh-credentials therefore invokes it
# with that venv's interpreter explicitly (see refresh_helper_python there). Running it with a
# bare `python3` works only if claude_swap happens to be importable.
"""claude-refresh-export — proactively refresh near-expiry accounts inside a
claude-swap export, IN PLACE, using claude-swap's own OAuth implementation.

WHY THIS EXISTS. The single-writer design says exactly one machine may refresh.
But nothing was actually *driving* that refresh: claude-swap only refreshes
lazily, when a token is already inside its 5-minute expiry buffer AND the slot
is not the active one (see oauth.try_fetch_usage_for_account). So the authority
sat on a token until it nearly expired, and receivers — holding the same token,
with their own refresh buffers — could reach that buffer first, refresh, rotate
the single-use token, and kill the fleet. That is exactly what happened on
2026-08-19.

Refreshing EARLY and pushing immediately removes the trough: receivers are
handed a fresh ~8h token long before anything of theirs comes due, so no
receiver ever has a reason to refresh.

DANGER: an OAuth refresh token is single-use and rotates server-side on the POST.
The moment the exchange succeeds the previous generation is DEAD. So the result is
written to disk BEFORE it is verified — a credential we hold but failed to verify
is recoverable, one we never persisted is not.

Usage: claude-refresh-export <export.json> <refresh-below-seconds>
Exit:  0 nothing needed / all refreshes succeeded
       1 at least one refresh failed (file still valid; untouched accounts intact)
       2 usage error
"""
import json
import os
import sys
import tempfile
import time
import urllib.error
import urllib.request

from claude_swap.oauth import try_refresh_oauth_credentials


def life_seconds(oauth):
    exp = oauth.get("expiresAt")
    if not isinstance(exp, (int, float)):
        return None
    return int(exp / 1000 - time.time())


def verify(token):
    """Probe the access token. Read-only: consumes nothing single-use."""
    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={"Authorization": "Bearer " + token},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status == 200, str(r.status)
    except urllib.error.HTTPError as e:
        return False, "HTTP %s" % e.code
    except Exception as e:                                  # noqa: BLE001
        return False, type(e).__name__


def write_atomic(path, data):
    d = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".refresh-", suffix=".json")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    if len(sys.argv) != 3:
        print(__doc__.strip().splitlines()[-4], file=sys.stderr)
        return 2
    path, below = sys.argv[1], int(sys.argv[2])

    with open(path) as f:
        doc = json.load(f)
    accounts = doc.get("accounts") or []
    if not accounts:
        print("FATAL export has no accounts", file=sys.stderr)
        return 2

    failed = 0
    for a in accounts:
        email = a.get("email", "?")
        creds = a.get("credentials") or {}
        oauth = creds.get("claudeAiOauth") or {}
        life = life_seconds(oauth)

        if life is None:
            print("SKIP     %s (no expiresAt)" % email)
            continue
        if life >= below:
            print("OK       %s %dm left" % (email, life // 60))
            continue
        if not oauth.get("refreshToken"):
            print("FAILED   %s no refresh token (setup-token?)" % email)
            failed += 1
            continue

        old_tail = (oauth.get("accessToken") or "")[-6:]
        out = try_refresh_oauth_credentials(json.dumps(creds))
        if out.error is not None or not out.credentials:
            print("FAILED   %s %dm left, refresh error=%s"
                  % (email, life // 60, out.error))
            failed += 1
            continue

        # PERSIST FIRST. The old generation is already dead at this point.
        a["credentials"] = json.loads(out.credentials)
        write_atomic(path, doc)

        new_oauth = a["credentials"]["claudeAiOauth"]
        new_tail = (new_oauth.get("accessToken") or "")[-6:]
        new_life = life_seconds(new_oauth) or 0
        good, detail = verify(new_oauth.get("accessToken") or "")
        status = "REFRESHED" if good else "REFRESHED-UNVERIFIED"
        print("%s %s ...%s -> ...%s, %dm left (probe %s)"
              % (status, email, old_tail, new_tail, new_life // 60, detail))
        if not good:
            # Kept deliberately: it is the only live generation we have.
            failed += 1

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
