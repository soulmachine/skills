# /etc/kimi-k26.env — read by kimi-k26.service (systemd EnvironmentFile).
#
# CRITICAL: systemd EnvironmentFile does NOT strip inline '# ...' comments — it folds the rest of the
# line into the value. A line like `HF_HOME=/mnt/nvme/hf  # cache` sets HF_HOME to
# "/mnt/nvme/hf  # cache", which breaks the weight mount (LocalEntryNotFoundError). Keep every
# KEY=value BARE; put comments on their own full lines only.
#
# Switch quant/engine = edit this file, then: sudo systemctl restart kimi-k26

# --- engine + quant ------------------------------------------------------------------------------
# FRAMEWORK: vllm | sglang   (sglang supports QUANT=int4 only on sm_120; nvfp4 = NaN there)
# QUANT:     int4 | nvfp4
FRAMEWORK=vllm
QUANT=int4

# --- image (PIN a tag; never :latest) ------------------------------------------------------------
# int4+vllm:   vllm/vllm-openai:v0.22.1
# int4+sglang: lmsysorg/sglang:v0.5.12.post1-cu130
# nvfp4+vllm:  kimi-k26-nvfp4-vllm:cu130-mla   (build once: bash build_nvfp4_image.sh)
IMAGE=vllm/vllm-openai:v0.22.1

# --- host / paths --------------------------------------------------------------------------------
# Absolute HF_HOME — your HF hub cache root on a big NVMe (systemd does NOT expand ~ or $HOME). EDIT THIS.
HF_HOME=/path/to/hf-cache
PORT=30000
NAME=kimi-k26

# --- optional tuning -----------------------------------------------------------------------------
# fp8 KV roughly doubles the KV pool at ~no throughput cost (re-verify numerics). vLLM: fp8 ; SGLang: fp8_e4m3
# KV_CACHE_DTYPE=fp8
# NVFP4 only: marlin (faster on sm_120) | flashinfer_b12x (native FP4 tensor cores, ~12% slower here)
# MOE_BACKEND=marlin
# MODEL_NAME: the OpenAI `model` id clients send (default kimi-k2.6). Keep stable across your fleet.
# MODEL_NAME=kimi-k2.6
# MAX_SEQS — vLLM ONLY (maps to --max-num-seqs): caps concurrent running sequences (latency / KV-
# pressure guard). serve_docker_sglang.sh does NOT read MAX_SEQS — SGLang's pool-based scheduler
# (sized by --mem-fraction-static) bounds concurrency on its own, so no cap is needed there; its
# equivalent flag --max-running-requests is deliberately not wired. NB measured 2026-06-12: the box
# saturates at ~c32 (c16 leaves ~17% throughput on the table) — cap at 16 only to bound KV, not for perf.
# MAX_SEQS=16
# HOST — engine bind address (default 0.0.0.0 = all interfaces; raw :PORT then answers unauthenticated
# on loopback/LAN/tailnet, auth boundary is Caddy :443 + the router). Set HOST=127.0.0.1 to lock it
# down so ONLY the Caddy proxy reaches the model. Caddy always upstreams over loopback either way.
# HOST=0.0.0.0

# --- NVFP4 example (comment the int4 lines above, uncomment these) --------------------------------
# FRAMEWORK=vllm
# QUANT=nvfp4
# IMAGE=kimi-k26-nvfp4-vllm:cu130-mla
# KV_CACHE_DTYPE=fp8
# MOE_BACKEND=marlin
