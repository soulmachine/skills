# /etc/kimi-k26.env — read by kimi-k26.service (systemd EnvironmentFile).
#
# CRITICAL: systemd EnvironmentFile does NOT strip inline '# ...' comments — it folds the rest of the
# line into the value. A line like `HF_HOME=/data/huggingface  # cache` sets HF_HOME to
# "/data/huggingface  # cache", which breaks the weight mount (LocalEntryNotFoundError). Keep every
# KEY=value BARE; put comments on their own full lines only.
#
# Switch quant/engine = edit this file, then: sudo systemctl restart kimi-k26

# --- engine + quant ------------------------------------------------------------------------------
# FRAMEWORK: vllm | sglang   (sglang supports QUANT=int4 only on sm_120; nvfp4 = NaN there)
# QUANT:     int4 | nvfp4
FRAMEWORK=vllm
QUANT=int4

# --- image (PIN a tag; never :latest) ------------------------------------------------------------
# int4+vllm:   vllm/vllm-openai:v0.22.1
# int4+sglang: lmsysorg/sglang:v0.5.12.post1-cu130
# nvfp4+vllm:  kimi-k26-nvfp4-vllm:cu130-mla   (build once: bash build_nvfp4_image.sh)
IMAGE=vllm/vllm-openai:v0.22.1

# --- host / paths --------------------------------------------------------------------------------
# Absolute HF_HOME (systemd does not expand ~). Checkpoint resolves from its hub cache.
HF_HOME=/data/huggingface
PORT=30000
NAME=kimi-k26

# --- optional tuning -----------------------------------------------------------------------------
# fp8 KV roughly doubles the KV pool at ~no throughput cost (re-verify numerics). vLLM: fp8 ; SGLang: fp8_e4m3
# KV_CACHE_DTYPE=fp8
# NVFP4 only: marlin (faster on sm_120) | flashinfer_b12x (native FP4 tensor cores, ~12% slower here)
# MOE_BACKEND=marlin
# SERVED_NAME: the OpenAI `model` id clients send (default kimi-k2.6). Keep stable across your fleet.
# SERVED_NAME=kimi-k2.6
# MAX_SEQS (vLLM): cap concurrent sequences; lower = less KV pressure (sweep saturates ~16 here).
# MAX_SEQS=16

# --- NVFP4 example (comment the int4 lines above, uncomment these) --------------------------------
# FRAMEWORK=vllm
# QUANT=nvfp4
# IMAGE=kimi-k26-nvfp4-vllm:cu130-mla
# KV_CACHE_DTYPE=fp8
# MOE_BACKEND=marlin
