# /etc/kimi-k3-interactive.env — read by kimi-k3-interactive.service. INTERACTIVE profile: few slots +
# DSpark speculative decoding = best single-stream latency (measured 2026-09-05 on REAP-770: c1 12.96 tok/s,
# TPOT 62 ms vs 8.99 / 98 ms for the throughput profile at 4 slots; loses from c4 up, hence 2 slots).
# Requires an image with BOTH patches (…-lip-rsrb), the converted draft at $SNAP/drafts/, the draft on the
# GPU holding the target's output.weight (CUDA7 on an 8-GPU layer split) with ~13 GB margin there, and
# ~7 GB of rollback snapshots at 2 slots x 7 drafts (per-device --fit-target list). Same warning as the
# main env: keep values BARE except the quoted EXTRA_ARGS. Starting this unit stops kimi-k3.service.
QUANT=UD-Q2_K_XL-REAP770
BUILD_SOURCE=fork
IMAGE=kimi-k3-llamacpp:fork-883f2c9ba78f-lip-rsrb
HF_HOME=/path/to/hf-cache
PORT=30000
NAME=kimi-k3
MODEL_NAME=kimi-k3
GPU_ARGS=--device nvidia.com/gpu=all
CTX_SIZE=16384
PARALLEL=2
BATCH=2048
UBATCH=2048
EXTRA_ARGS="--fit-target 5120,5120,5120,5120,5120,5120,5120,13312 -md /models/repo/drafts/Kimi-K3-DSpark-bf16.gguf --spec-type draft-dspark --spec-draft-n-max 7 -ngld 99 --spec-draft-device CUDA7"
